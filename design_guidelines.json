  "motion_and_interactions": {
    "philosophy": "Subtle, utility-first micro-interactions only. Zero distracting flashy effects.",
    "hover_transitions": "transition-colors duration-150 ease-in-out",
    "modals": "Fade-in backdrop and smooth scale-in dialog (150ms ease-out)",
    "toasts": "Sonner bottom-right rich colors for instant confirmation upon stock update or invoice generation",
    "skeletons": "Pulsing slate-100/200 rectangular blocks for loading states in metric cards and table rows"
  },
  "accessibility_and_testing": {
    "contrast_standard": "WCAG AA (4.5:1 minimum on all text, 3:1 on large headings and borders)",
    "testing_attributes": "All interactive elements (buttons, inputs, links, select triggers, table actions) MUST include explicit data-testid attributes",
    "test_id_examples": [
      "data-testid=\"nav-dashboard\"",
      "data-testid=\"nav-products\"",
      "data-testid=\"nav-create-invoice\"",
      "data-testid=\"nav-invoices-history\"",
      "data-testid=\"nav-settings\"",
      "data-testid=\"metric-total-products\"",
      "data-testid=\"metric-low-stock\"",
      "data-testid=\"metric-out-of-stock\"",
      "data-testid=\"stock-search-input\"",
      "data-testid=\"filter-tab-low-stock\"",
      "data-testid=\"add-product-btn\"",
      "data-testid=\"add-stock-btn-{code}\"",
      "data-testid=\"edit-product-btn-{code}\"",
      "data-testid=\"delete-product-btn-{code}\"",
      "data-testid=\"invoice-customer-name-input\"",
      "data-testid=\"invoice-item-select-0\"",
      "data-testid=\"invoice-item-qty-0\"",
      "data-testid=\"invoice-discount-input\"",
      "data-testid=\"invoice-submit-btn\"",
      "data-testid=\"print-invoice-btn\"",
      "data-testid=\"view-invoice-btn-{invoice_no}\""
    ]
  },
  "instructions_to_main_agent": [
    "1. Replace font imports in index.css with @fontsource-variable/plus-jakarta-sans, @fontsource/poppins, and @fontsource-variable/lora.",
    "2. Configure theme tokens in index.css with Navy Blue #0F2942 as primary accent and crisp slate neutrals.",
    "3. Build responsive AppLayout with collapsible/desktop sidebar and top store header.",
    "4. Implement Dashboard page with 6 summary cards and quick stock view.",
    "5. Implement Products/Stock page with Add Product, Add Stock, Edit, Delete modals, real-time search and filter tabs.",
    "6. Implement Create Invoice screen with customer details, dynamic item rows, auto-calculation, stock availability validation, and submit action.",
    "7. Implement Invoice History page with search, date filter, view snapshot modal, and print trigger.",
    "8. Implement Store Settings page allowing customization of store name, phone, address, and invoice prefix.",
    "9. Create dedicated InvoicePrintSheet component strictly styled according to the user's reference invoice anatomy (light beige chip for invoice number, light beige table headers, light beige total box, serif thank you note, clean vertical borders, ₹ currency formatting).",
    "10. Add Sonner toast feedback and subtle skeleton loaders for all asynchronous operations.",
    "11. Seed the database with the 8 wholesale clothing products and 2 historical invoices provided in seed_data_blueprint."
  ]
}